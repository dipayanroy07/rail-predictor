# RailPredictor environment variable template.
#
# Copy this file's contents into your own shell session / IntelliJ run configuration.
# NEVER commit a file containing real values - this file must only ever contain placeholders.
# Every property here is optional and has a safe default (see src/main/resources/application*.properties);
# only set what you actually need. See docs/configuration.md for the full reference with rationale.

# ---- Core: required for real (non-mock) operation ----

# Activates DataSource/JPA/Flyway and every "postgres"-backed provider. Omit entirely (or leave
# unset) to run with zero persistence, using only mock providers.
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL connection (only read when SPRING_PROFILES_ACTIVE=postgres).
DB_URL=jdbc:postgresql://localhost:5432/railpredictor
DB_USERNAME=your-postgres-username
DB_PASSWORD=your-postgres-password

# RailRadar API key (https://railradar.in) - required for any real live-train request.
# Without it, live prediction requests fail fast with a clear "no API key configured" error.
RAILRADAR_API_KEY=your-railradar-api-key
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_TIMEOUT=5s

# ---- Provider selection: which real vs. mock data source is used ----

# "mock" (default) or "openmeteo". Open-Meteo's free/non-commercial tier needs no API key at all.
WEATHER_PROVIDER=mock
WEATHER_OPENMETEO_API_KEY=
WEATHER_OPENMETEO_BASE_URL=https://api.open-meteo.com
WEATHER_OPENMETEO_TIMEOUT=5s

# "mock" (default) or "postgres" - postgres requires SPRING_PROFILES_ACTIVE=postgres too, and
# fails loudly (never silently falls back to mock) if that profile isn't also active.
HISTORICAL_PROVIDER=mock
HISTORICAL_SECTION_PROVIDER=mock

# "unavailable" (default, honest - no reliable real source exists) or "mock" for local testing.
RAILWAY_DISRUPTION_PROVIDER=unavailable

# ---- Real-data accumulation (all default false/empty - opt-in, each a genuinely new side effect) ----

# Records every live RailRadar response as a historical observation, for the listed trains.
HISTORICAL_COLLECTION_ENABLED=false
HISTORICAL_COLLECTION_TRAIN_NUMBERS=
HISTORICAL_COLLECTION_INTERVAL_MS=3600000
HISTORICAL_COLLECTION_INITIAL_DELAY_MS=300000

# Autonomously calls the prediction pipeline for the same configured train list (reuses
# HISTORICAL_COLLECTION_TRAIN_NUMBERS above), so prediction_snapshots accumulates unattended.
PREDICTION_COLLECTION_ENABLED=false
PREDICTION_COLLECTION_INTERVAL_MS=3600000
PREDICTION_COLLECTION_INITIAL_DELAY_MS=600000

# Records a snapshot of every live prediction for later accuracy evaluation, and periodically
# matches PENDING snapshots against real outcomes.
PREDICTION_EVALUATION_ENABLED=false
PREDICTION_EVALUATION_REFRESH_INTERVAL_MS=3600000
PREDICTION_EVALUATION_REFRESH_INITIAL_DELAY_MS=120000

# Attaches empirical calibration/ablation analysis to GET /api/v1/evaluation/accuracy. See
# docs/evaluation-methodology.md for the sample-size gate this respects.
EVALUATION_CALIBRATION_ENABLED=false
EVALUATION_CALIBRATION_MINIMUM_SAMPLE_COUNT=30
EVALUATION_CALIBRATION_VALIDATION_SPLIT=0.3
EVALUATION_CALIBRATION_MIN_IMPROVEMENT_PERCENT=5.0

# ---- Everything else below is a tuning knob with a documented default ----
# (see docs/configuration.md and docs/prediction-model.md for what each one means and why its
# default was chosen - none of these have been empirically calibrated against real data; see
# docs/evaluation-methodology.md)

PREDICTION_ASSUMED_AVERAGE_SPEED_KMH=60.0
PREDICTION_HISTORICAL_ADJUSTMENT_WEIGHT=0.2
PREDICTION_HISTORICAL_MINIMUM_SAMPLE_COUNT=5
HISTORICAL_SECTION_MINIMUM_SAMPLE_COUNT=10

CONFIDENCE_WEIGHT_LIVE_DATA=15
CONFIDENCE_WEIGHT_WEATHER=10
CONFIDENCE_WEIGHT_HISTORICAL=15
CONFIDENCE_WEIGHT_ROUTE=10
CONFIDENCE_WEIGHT_SPEED=15
CONFIDENCE_WEIGHT_SECTION=10
CONFIDENCE_WEIGHT_SIMULATION=25
CONFIDENCE_THRESHOLD_HIGH=80
CONFIDENCE_THRESHOLD_MEDIUM=60
CONFIDENCE_THRESHOLD_LOW=35
CONFIDENCE_MAX_STABLE_DISRUPTIONS=1

DISRUPTION_HEAVY_RAIN_PROBABILITY=0.5
DISRUPTION_HEAVY_RAIN_MIN_DELAY_MINUTES=5
DISRUPTION_HEAVY_RAIN_MAX_DELAY_MINUTES=20
DISRUPTION_DENSE_FOG_PROBABILITY=0.5
DISRUPTION_DENSE_FOG_MIN_DELAY_MINUTES=10
DISRUPTION_DENSE_FOG_MAX_DELAY_MINUTES=30
DISRUPTION_HIGH_CONGESTION_PROBABILITY=0.4
DISRUPTION_HIGH_CONGESTION_MIN_DELAY_MINUTES=5
DISRUPTION_HIGH_CONGESTION_MAX_DELAY_MINUTES=15
DISRUPTION_ENGINEERING_BLOCK_PROBABILITY=0.3
DISRUPTION_ENGINEERING_BLOCK_MIN_DELAY_MINUTES=15
DISRUPTION_ENGINEERING_BLOCK_MAX_DELAY_MINUTES=45
DISRUPTION_SIGNAL_HALT_PROBABILITY=0.3
DISRUPTION_SIGNAL_HALT_MIN_DELAY_MINUTES=3
DISRUPTION_SIGNAL_HALT_MAX_DELAY_MINUTES=10
DISRUPTION_SPEED_RESTRICTION_FLAT_DELAY_MINUTES=10

CASCADE_MIN_TRIGGER_DELAY_MINUTES=10
CASCADE_FACTOR=0.3
CASCADE_MAX_DEPTH=3
CASCADE_MAX_TOTAL_DELAY_MINUTES=30
CASCADE_MAX_AFFECTED_ENTITIES=3

RECOVERY_BASE_FRACTION=0.2
RECOVERY_ADVERSE_WEATHER_MULTIPLIER=0.5
RECOVERY_MAX_MINUTES_PER_KM=0.05
RECOVERY_FLAT_MAX_MINUTES=10

RAILWAY_DISRUPTION_IMPACT_ENGINEERING_BLOCK_DEFAULT_DELAY_MINUTES=15
RAILWAY_DISRUPTION_IMPACT_SIGNAL_FAILURE_DEFAULT_DELAY_MINUTES=10
RAILWAY_DISRUPTION_IMPACT_CONGESTION_DEFAULT_DELAY_MINUTES=10
RAILWAY_DISRUPTION_IMPACT_MAX_SINGLE_DELAY_MINUTES=60
RAILWAY_DISRUPTION_IMPACT_MAX_AGGREGATE_DELAY_MINUTES=90

ROUTE_NORMAL_THRESHOLD_MINUTES=10
ROUTE_BUSY_THRESHOLD_MINUTES=30

HISTORICAL_OBSERVATION_MAX_PLAUSIBLE_DELAY_MINUTES=4320
HISTORICAL_JOURNEY_DATE_OPERATING_DAY_START_HOUR=0
HISTORICAL_PROFILE_REFRESH_INTERVAL_MS=3600000
HISTORICAL_PROFILE_REFRESH_INITIAL_DELAY_MS=60000
